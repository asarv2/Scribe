{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ES2020",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "outDir": "./dist",
      "sourceMap": true,
      "strict": true,
      "lib": ["ES2020", "DOM"],
      "typeRoots": ["./node_modules/@types"],
      "resolveJsonModule": true
    },
    "include": ["src/**/*", "config.dev.ts", "config.prod.ts"],
    "exclude": ["node_modules"]
  }
  